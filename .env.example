# Server — copy to .env, never commit .env
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/inkwell

# MUST equal frontend AUTH_SECRET (shared JWT verification)
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Cloudinary (Phase 3 — leave empty until needed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI: openrouter | groq | ollama | none (Ollama = local Gemma deep agent, LangGraph)
AI_PROVIDER=ollama
AI_API_KEY=
AI_MODEL=
# e.g. openrouter: meta-llama/llama-3.1-8b-instruct:free
# e.g. groq: llama-3.1-8b-instant
# e.g. ollama: gemma4 (requires Ollama running at OLLAMA_BASE_URL)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4
AI_MAX_TOKENS=2000
AI_RATE_LIMIT_PER_MIN=20

# AI Blog Generation Pipeline
AI_GEN_CONCURRENCY=2
AI_GEN_TIMEOUT_MS=300000
AI_GEN_MAX_RETRIES=2
AI_GEN_MAX_REVISIONS=2
